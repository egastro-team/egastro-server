meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

docs {
  RUN.md section 3. Expected 201. Repeat registration returns 409. Change userEmail for another customer. Registration does not issue a token.
}
